            }
          ]
        },
        {
          "type": "basic",
          "description": "TAB / hold left_shift",
          "from": {
            "key_code": "tab",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_shift",
              "lazy": true,
