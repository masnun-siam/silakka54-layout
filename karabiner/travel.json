{
  "title": "Siam's Silakka54 \u2014 travel layout",
  "rules": [
    {
      "description": "NAV layer \u2014 hold Space (hjkl arrows, row below = Home/PgDn/PgUp/End)",
      "manipulators": [
        {
          "type": "basic",
          "description": "NAV h -> left_arrow",
          "from": {
            "key_code": "h",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_arrow"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "slk_nav",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "description": "NAV j -> down_arrow",
          "from": {
            "key_code": "j",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "down_arrow"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "slk_nav",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "description": "NAV k -> up_arrow",
          "from": {
            "key_code": "k",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "up_arrow"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "slk_nav",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "description": "NAV l -> right_arrow",
          "from": {
            "key_code": "l",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_arrow"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "slk_nav",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "description": "NAV n -> home",
          "from": {
            "key_code": "n",
            "modifiers": {
              "optional": [
                "any"
              ]
